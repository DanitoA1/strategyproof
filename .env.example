# Daytona
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=

# Kimi (Moonshot)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.5

# Nosana
NOSANA_API_KEY=
NOSANA_BASE_URL=https://inference.nosana.com/v1
NOSANA_MODEL=

# Dataset
DATASET_PATH=./data/eurusd_15m.csv

# Development-only fallbacks
MOCK_KIMI=false
MOCK_NOSANA=false

# Video import (Gemini via OpenRouter; falls back to KIMI_API_KEY)
VIDEO_API_KEY=
VIDEO_BASE_URL=https://openrouter.ai/api/v1
VIDEO_MODEL=google/gemini-3.8-flash
